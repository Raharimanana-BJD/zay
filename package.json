{
  "name": "zay-app",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.12",
      "@tanstack/react-query": "^5.104.2",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@trpc/tanstack-react-query": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "@tanstack/react-form": "^1.33.5",
      "@better-auth/expo": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5",
      "recharts": "3.8.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @zay-app/db --",
    "db:studio": "turbo run db:studio -F @zay-app/db --",
    "db:generate": "turbo run db:generate -F @zay-app/db --",
    "db:migrate": "turbo run db:migrate -F @zay-app/db --",
    "db:start": "turbo run db:start -F @zay-app/db --",
    "db:watch": "turbo run db:watch -F @zay-app/db --",
    "db:stop": "turbo run db:stop -F @zay-app/db --",
    "db:down": "turbo run db:down -F @zay-app/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "db:verify": "cd apps/server && bun run db:verify",
    "admin:create": "cd apps/server && bun run admin:create",
    "seed:backoffice": "cd apps/server && bun run seed:backoffice",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "catalog:",
    "@zay-app/config": "workspace:*",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}

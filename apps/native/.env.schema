# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Local server by default. A release build (NODE_ENV=production) reads .env.production.
# @public @type=url
EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# Written into the app, so readable by anyone. Without it, map tiles show "API KEY REQUIRED".
# @public
EXPO_PUBLIC_CARTO_API_KEY=

# Shows "Continuer avec Google" on the sign in screen. The server needs its Google keys too.
# @public @type=boolean @optional
EXPO_PUBLIC_GOOGLE_SIGN_IN=false

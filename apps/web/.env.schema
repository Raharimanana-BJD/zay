# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Written into the browser code, so readable by anyone. Without it, map tiles show "API KEY REQUIRED".
# @public
VITE_CARTO_API_KEY=

# Address of the Android APK file. Public. Empty: the landing page shows "Bientôt disponible".
# @public @type=url @optional
VITE_APK_URL=

# Public address of the site, without a trailing slash, for the share image and the canonical link. Empty: both are left out.
# @public @type=url @optional
VITE_SITE_URL=

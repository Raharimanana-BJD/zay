# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# SMTP server for auth emails. Locally, Mailpit from packages/db (interface on http://localhost:8026).
# @type=url
SMTP_URL=smtp://localhost:1026

# @public
MAIL_FROM=Zay <no-reply@zay.mg>

# Google sign in (mobile). Leave both empty to turn it off.
# Redirect URI to register at Google: <BETTER_AUTH_URL>/api/auth/callback/google
# @optional @sensitive=false
GOOGLE_CLIENT_ID=

# @optional
GOOGLE_CLIENT_SECRET=

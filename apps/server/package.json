{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "admin:create": "bun run scripts/create-admin.ts",
    "auth:generate": "varlock run -- bun x auth@1.7.12 generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:verify": "bun run scripts/verify-data-model.ts",
    "dev": "bun run --hot src/index.ts",
    "env:generate": "varlock codegen",
    "seed:backoffice": "bun run scripts/seed-backoffice.ts",
    "seed:mobile": "bun run scripts/seed-mobile.ts",
    "start": "bun run dist/index.mjs",
    "verify:mobile": "bun run scripts/verify-mobile-flow.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "@zay-app/api": "workspace:*",
    "@zay-app/auth": "workspace:*",
    "@zay-app/db": "workspace:*",
    "@zay-app/email": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@zay-app/config": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
